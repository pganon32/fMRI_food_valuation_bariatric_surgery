  },
  {
   "cell_type": "code",
   "execution_count": 137,
   "id": "12ae0db6",
   "metadata": {},
   "outputs": [],
   "source": [
    "# Path to the CSV file\n",
    "csv_file_path = 'C:\\\\Users\\\\Patrick\\\\Gutbrain_R\\\\data\\\\kcal_real_v3.csv'\n",
    "\n",
    "# Load the CSV file into a DataFrame\n",
    "dfkcalreal = pd.read_csv(csv_file_path)\n",
    "\n",
    "# Convert the 'picture' column to lowercase in df\n",
    "finaldf['picture'] = finaldf['picture'].str.lower()\n",
    "\n",
    "# Convert the 'picture' column to lowercase in dfkcalreal\n",
    "dfkcalreal['picture'] = dfkcalreal['picture'].str.lower()\n",
    "\n",
    "# Insert the new column 'kcalreal' after the 'estcal' column\n",
    "finaldf.insert(df.columns.get_loc('estcal') + 1, 'kcalreal', None)\n",
    "\n",
    "dfkcalreal.rename(columns={'Moyenne Densite': 'kcalreal'}, inplace=True)\n",
    "\n",
    "columns_to_remove = ['Dénomination', 'Différence', 'Source', 'Source autre', 'Annee Prix', 'Source Prix (si autre)', 'Pays prix', 'Commentaire']\n",
    "dfkcalreal = dfkcalreal.drop(columns=columns_to_remove, errors='ignore')\n"
   ]
  },
  {
   "cell_type": "markdown",
   "id": "0f353ddf",
   "metadata": {},
   "source": [
    "Clean kcal real df (raw price and caloric density info)"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 138,
   "id": "f5c18349",
   "metadata": {},
   "outputs": [],
   "source": [
    "# Extract food category and food name from paths such as:\n",
    "# food/hisweetmaynards.bmp -> HiSweet, maynards\n",
    "# food/lonectarine.jpg -> Lo, nectarine\n",
    "parsed_picture = dfkcalreal[\"picture\"].str.extract(\n",
    "    r\"^food/(?P<type>hi(?:sweet|salt)|lo)(?P<picture>.+)\\.(?:bmp|jpg)$\",\n",
    "    expand=True,\n",
    "    flags=re.IGNORECASE\n",
    ")\n",
    "\n",
    "dfkcalreal[[\"type\", \"picture\"]] = parsed_picture\n",
    "dfkcalreal[\"type\"] = dfkcalreal[\"type\"].str.lower()\n",
    "dfkcalreal[\"picture\"] = dfkcalreal[\"picture\"].str.lower()"
   ]
  },
  {
   "cell_type": "markdown",
   "id": "50b65aa1",
   "metadata": {},
   "source": [
    "Clean strings + validation"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 139,
   "id": "e984710f",
   "metadata": {},
   "outputs": [
    {
     "name": "stdout",
     "output_type": "stream",
     "text": [
      "Matching unique pictures: 70\n",
      "Pictures in finaldf but not dfkcalreal:\n",
      "[]\n",
      "Pictures in dfkcalreal but not finaldf:\n",
      "[]\n"
     ]
    }
   ],
   "source": [
    "# Canonicalize known picture-name variants used by the two datasets\n",
    "picture_aliases = {\n",
    "    \"juliennes\": \"julienne\",\n",
    "}\n",
    "\n",
    "# Rebuild the normalized picture values after applying aliases\n",
    "final_picture_values = (\n",
    "    finaldf[\"picture\"]\n",
    "    .astype(\"string\")\n",
    "    .str.strip()\n",
    "    .str.lower()\n",
    "    .replace(picture_aliases)\n",
    ")\n",
    "\n",
    "kcal_picture_values = (\n",
    "    dfkcalreal[\"picture\"]\n",
    "    .astype(\"string\")\n",
    "    .str.strip()\n",
    "    .str.lower()\n",
    "    .replace(picture_aliases)\n",
    ")\n",
    "\n",
    "# Convert the refreshed values to sets\n",
    "final_pictures = set(final_picture_values.dropna())\n",
    "kcal_pictures = set(kcal_picture_values.dropna())\n",
    "\n",
    "matching_unique = final_pictures & kcal_pictures\n",
    "\n",
    "print(f\"Matching unique pictures: {len(matching_unique)}\")\n",
    "\n",
    "print(\"Pictures in finaldf but not dfkcalreal:\")\n",
    "print(sorted(final_pictures - kcal_pictures))\n",
    "\n",
    "print(\"Pictures in dfkcalreal but not finaldf:\")\n",
    "print(sorted(kcal_pictures - final_pictures))\n",
    "\n",
    "assert \"julienne\" not in (final_pictures - kcal_pictures)\n",
    "assert \"julienne\" not in (kcal_pictures - final_pictures)"
   ]
  },

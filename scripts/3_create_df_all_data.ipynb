   "source": [
    "# Insert new columns after the 'value' column\n",
    "df.insert(df.columns.get_loc('value') + 1, 'known', None)\n",
    "df.insert(df.columns.get_loc('value') + 2, 'freq', None)\n",
    "df.insert(df.columns.get_loc('value') + 3, 'like', None)\n",
    "df.insert(df.columns.get_loc('value') + 4, 'estcal', None)\n",
    "\n",
    "# Create a list of column names\n",
    "columns = list(ChoixColl.columns)\n",
    "\n",
    "# Insert empty columns to the right of columns containing '4'\n",
    "i = 0\n",
    "while i < len(columns):\n",
    "    if '4' in columns[i]:\n",
    "        columns.insert(i + 1, f'empty_col_{i + 1}')\n",
    "        i += 1  # Skip the newly added column\n",
    "    i += 1\n",
    "\n",
    "# Reindex the DataFrame with the new columns\n",
    "ChoixColl = ChoixColl.reindex(columns=columns)\n",
    "\n",
    "# Identify columns with 'empty' in their name\n",
    "empty_columns = [col for col in ChoixColl.columns if 'empty' in col]\n",
    "\n",
    "# Concatenate values from the 4 previous columns for each row\n",
    "for empty_col in empty_columns:\n",
    "    empty_col_index = ChoixColl.columns.get_loc(empty_col)\n",
    "    if isinstance(empty_col_index, int) and empty_col_index >= 4:  # Ensure there are at least 4 previous columns\n",
    "        previous_cols = ChoixColl.columns[empty_col_index-4:empty_col_index]\n",
    "        ChoixColl[empty_col] = ChoixColl[previous_cols].astype(str).agg(';'.join, axis=1)\n",
    "\n",
    "# Loop through the columns\n",
    "for i in range(1, len(ChoixColl.columns)):\n",
    "    if 'empty' in ChoixColl.columns[i]:\n",
    "        previous_col = ChoixColl.columns[i - 1]\n",
    "        if '4' in previous_col:\n",
    "            new_name = previous_col.split('4')[0]\n",
    "            ChoixColl.rename(columns={ChoixColl.columns[i]: new_name}, inplace=True)\n",
    "\n",
    "# List to keep track of columns to drop\n",
    "columns_to_drop = []\n",
    "\n",
    "# Loop through columns\n",
    "for i, col in enumerate(ChoixColl.columns):\n",
    "    if '4' in col:\n",
    "        # Add this column and the previous three columns to the drop list\n",
    "        columns_to_drop.extend(ChoixColl.columns[max(0, i-3):i+1])\n",
    "\n",
    "# Drop the columns and create a new DataFrame\n",
    "ChoixCollConcat = ChoixColl.drop(columns=columns_to_drop)\n",
    "\n",
    "# Replace column name 'idrecherchescan' with 'id_participant'\n",
    "ChoixCollConcat.rename(columns={'idrecherchescan': 'id_participant'}, inplace=True)\n",
    "\n",
    "# Melt the DataFrame \n",
    "ChoixCollConcat_melted = pd.melt(ChoixCollConcat, id_vars=['id_participant'], var_name='picture', value_name='value')\n",
    "\n",
    "# Get unique values of 'picture' column from both dataframes\n",
    "unique_pictures_df = df['picture'].unique()\n",
    "unique_pictures_choixcollconcat_melted = ChoixCollConcat_melted['picture'].unique()\n",
    "\n",
    "# Find the differences between the two sets of unique values\n",
    "unique_in_df_not_in_choixcollconcat_melted = set(unique_pictures_df) - set(unique_pictures_choixcollconcat_melted)\n",
    "unique_in_choixcollconcat_melted_not_in_df = set(unique_pictures_choixcollconcat_melted) - set(unique_pictures_df)\n",
    "\n",
    "# Print the differences\n",
    "print(\"Unique values in df['picture'] not in ChoixCollConcat_melted['picture']:\", unique_in_df_not_in_choixcollconcat_melted)\n",
    "print(\"Unique values in ChoixCollConcat_melted['picture'] not in df['picture']:\", unique_in_choixcollconcat_melted_not_in_df)\n",
    "\n",
    "# Check if there are exact matches\n",
    "if not unique_in_df_not_in_choixcollconcat_melted and not unique_in_choixcollconcat_melted_not_in_df:\n",
    "    print(\"There are exact matches for unique values of 'picture' column in both dataframes.\")\n",
    "else:\n",
    "    print(\"There are differences in the unique values of 'picture' column between the two dataframes.\")\n",
    "\n",
    "ChoixCollConcat_melted = ChoixCollConcat_melted.applymap(lambda x: x.lower() if isinstance(x, str) else x)\n",
    "ChoixCollConcat_melted\n",
    "\n",
    "# Assuming ChoixCollConcat_melted and df are already defined\n",
    "\n",
    "# Step 1: Extract the picture columns and strip spaces\n",
    "pictures_choixcoll = ChoixCollConcat_melted['picture'].str.strip()\n",
    "pictures_df = df['picture'].str.strip()\n",

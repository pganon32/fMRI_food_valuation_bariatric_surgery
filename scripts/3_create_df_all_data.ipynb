   "source": [
    "# Create a new column 'sexeF' based on the 'sexe' column\n",
    "final_merged_quest['sexeF'] = final_merged_quest['sexe'].apply(lambda x: 1 if x == 2 else 0)\n",
    "\n",
    "# Insert the 'sexeF' column beside the 'sexe' column\n",
    "sexe_index = final_merged_quest.columns.get_loc('sexe')\n",
    "final_merged_quest.insert(sexe_index + 1, 'sexeF', final_merged_quest.pop('sexeF'))\n",
    "\n",
    "# Change the format of 'type_chx' to a string\n",
    "final_merged_quest['type_chx'] = final_merged_quest['type_chx'].astype(str)\n",
    "\n",
    "\n",
    "final_merged_quest\n",
    "\n"
